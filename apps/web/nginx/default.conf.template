# ${ABS_UPSTREAM} is substituted at container start by the nginx image's envsubst.
# Other $variables are nginx's own and are left alone (the image only substitutes defined env vars).
server {
  listen 80;
  root /usr/share/nginx/html;

  location ~ ^/(api|login|logout|auth|status|public)(/|$) {
    proxy_pass ${ABS_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Audio streams and cover art can be large.
    client_max_body_size 0;
    proxy_buffering off;
  }

  location = /manifest.webmanifest { default_type application/manifest+json; }

  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
